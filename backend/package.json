{
  "name": "warehouse-brain-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step needed'",
    "start": "node src/server.js",
    "db:migrate": "node-pg-migrate --config .pg-migrate.json -m migrations up",
    "db:rollback": "node-pg-migrate --config .pg-migrate.json -m migrations down",
    "db:seed": "node seed.js",
    "db:init": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "node-pg-migrate": "^7.6.0",
    "pem": "^1.14.8",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
